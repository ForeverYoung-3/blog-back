<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.blog.back.mapper.TagMapper">

    <!-- ==================== ResultMap ==================== -->
    <resultMap id="TagResultMap" type="com.blog.back.entity.Tag">
        <id     column="id"          property="id"/>
        <result column="name"        property="name"/>
        <result column="slug"        property="slug"/>
        <result column="color"       property="color"/>
        <result column="description" property="description"/>
        <result column="created_at"  property="createdAt"/>
        <result column="post_count"  property="postCount"/>
    </resultMap>

    <!-- ==================== 公共列片段 ==================== -->
    <sql id="Base_Column_List">
        id, name, slug, color, description, created_at
    </sql>

    <!-- ==================== 插入 ==================== -->
    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO tags (name, slug, color, description, created_at)
        VALUES (#{name}, #{slug}, #{color}, #{description}, NOW())
    </insert>

    <!-- ==================== 更新 ==================== -->
    <update id="updateById">
        UPDATE tags
        <set>
            <if test="name        != null">name        = #{name},</if>
            <if test="slug        != null">slug        = #{slug},</if>
            <if test="color       != null">color       = #{color},</if>
            <if test="description != null">description = #{description},</if>
        </set>
        WHERE id = #{id}
    </update>

    <!-- ==================== 删除 ==================== -->
    <delete id="deleteById">
        DELETE FROM tags WHERE id = #{id}
    </delete>

    <!-- ==================== 查询 ==================== -->
    <select id="findById" resultMap="TagResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM tags
        WHERE id = #{id}
        LIMIT 1
    </select>

    <select id="findBySlug" resultMap="TagResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM tags
        WHERE slug = #{slug}
        LIMIT 1
    </select>

    <select id="findByName" resultMap="TagResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM tags
        WHERE name = #{name}
        LIMIT 1
    </select>

    <!-- 查询所有标签，附带文章数，按文章数倒序 -->
    <select id="findAllOrderByPostCountDesc" resultMap="TagResultMap">
        SELECT t.id, t.name, t.slug, t.color, t.description, t.created_at,
               COUNT(pt.post_id) AS post_count
        FROM tags t
        LEFT JOIN post_tags pt ON t.id = pt.tag_id
        GROUP BY t.id, t.name, t.slug, t.color, t.description, t.created_at
        ORDER BY post_count DESC, t.created_at DESC
    </select>

    <!-- 按 id 列表批量查询 -->
    <select id="findByIds" resultMap="TagResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM tags
        WHERE id IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </select>

    <!-- 按文章 id 查询关联标签 -->
    <select id="findByPostId" resultMap="TagResultMap">
        SELECT t.id, t.name, t.slug, t.color, t.description, t.created_at
        FROM tags t
        INNER JOIN post_tags pt ON t.id = pt.tag_id
        WHERE pt.post_id = #{postId}
        ORDER BY t.name
    </select>

    <!-- ==================== 存在性检查 ==================== -->
    <select id="existsByName" resultType="boolean">
        SELECT COUNT(1) > 0 FROM tags WHERE name = #{name}
    </select>

    <select id="existsBySlug" resultType="boolean">
        SELECT COUNT(1) > 0 FROM tags WHERE slug = #{slug}
    </select>

    <!-- ==================== 统计 ==================== -->
    <select id="count" resultType="long">
        SELECT COUNT(1) FROM tags
    </select>

    <!-- ==================== post_tags 关联表操作 ==================== -->
    <insert id="insertPostTags">
        INSERT INTO post_tags (post_id, tag_id) VALUES
        <foreach collection="tagIds" item="tagId" separator=",">
            (#{postId}, #{tagId})
        </foreach>
    </insert>

    <delete id="deletePostTagsByPostId">
        DELETE FROM post_tags WHERE post_id = #{postId}
    </delete>

</mapper>
